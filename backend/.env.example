# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0

# Authentication
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ============================================
# VIDEO GENERATION APIs
# ============================================

# RunwayML Video Generation
RUNWAY_API_KEY=rwk_your_api_key_here
RUNWAY_API_BASE_URL=https://api.runwayml.com/v1
RUNWAY_MODEL=gen3  # gen3-turbo for faster processing

# Alternative: Stability AI (Phase 2)
STABILITY_API_KEY=sk_live_your_api_key_here
STABILITY_API_URL=https://api.stability.ai/v2beta/image-to-video

# ============================================
# TEXT-TO-SPEECH APIs
# ============================================

# Google Cloud Text-to-Speech
GOOGLE_TTS_PROJECT_ID=your-project-id
GOOGLE_TTS_KEY_FILE=./credentials/google-tts-service-account.json
GOOGLE_TTS_DEFAULT_VOICE=en-US-Neural2-C  # Neural2-C (default), Neural2-A, Neural2-E
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_ENCODING=MP3
GOOGLE_TTS_AUDIO_RATE=24000

# Alternative: ElevenLabs (Phase 2)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel voice

# ============================================
# VIDEO COMPOSITION
# ============================================

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg  # Linux/Mac: /usr/bin/ffmpeg, Windows: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_AUDIO_BITRATE=192k
FFMPEG_VIDEO_BITRATE=2000k
FFMPEG_TIMEOUT=300000  # 5 minutes in milliseconds

# ============================================
# WATERMARKING
# ============================================

# Watermark Configuration
WATERMARK_TEXT=Shreevid.ai
WATERMARK_POSITION=bottom-right  # bottom-right, bottom-left, top-right, top-left
WATERMARK_OFFSET_X=20
WATERMARK_OFFSET_Y=20
WATERMARK_FONT_SIZE=36
WATERMARK_FONT_COLOR=white
WATERMARK_BG_COLOR=black
WATERMARK_BG_OPACITY=0.3

# ============================================
# VIDEO GENERATION SETTINGS
# ============================================

# Processing Limits
MAX_VIDEO_DURATION=60  # seconds
MAX_VIDEO_RESOLUTION=1920x1080
VIDEO_FRAME_RATE=24

# Processing Timeouts
VIDEO_GENERATION_TIMEOUT=180000  # 3 minutes
TTS_GENERATION_TIMEOUT=60000     # 1 minute
VIDEO_COMPOSITION_TIMEOUT=300000 # 5 minutes

# ============================================
# FREE TIER LIMITS
# ============================================

# Free Tier Video Limits
FREE_TIER_VIDEOS_PER_MONTH=2
PAID_TIER_COST_PER_VIDEO_INR=5

# ============================================
# BUSINESS CONFIGURATION
# ============================================

# Company Info
COMPANY_NAME=Priority Technologies Inc.
PRODUCT_NAME=Shreevid.ai
SUPPORT_EMAIL=support@shreevid.ai

# Presale Configuration
PRESALE_PRICE_INR=2000
PRESALE_VIDEO_LIMIT=50
