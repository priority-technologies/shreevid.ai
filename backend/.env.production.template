# Shreevid AI - Production Environment Variables Template
# Copy this to .env and fill in your actual values

# Server Configuration
NODE_ENV=production
PORT=8080

# MongoDB Connection (Get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://shreevid_admin:<password>@shreevid-cluster.xxxxx.mongodb.net/shreevid?retryWrites=true&w=majority

# JWT Secret (Generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-string

# Frontend URL (Your subdomain)
FRONTEND_URL=https://shreevid.prioritytechnologiess.com

# RunwayML API Configuration
RUNWAYML_API_KEY=your-runwayml-api-key-here
RUNWAYML_API_URL=https://api.runwayml.com/v1

# Google Cloud Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-tts-service-account.json
GOOGLE_CLOUD_PROJECT=shreevid-ai-prod

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin Configuration
ADMIN_EMAIL=priorityassociates8@gmail.com
ADMIN_INITIAL_PASSWORD=change-this-secure-password

# File Upload Configuration
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,video/mp4

# Watermark Configuration
WATERMARK_TEXT=Shreevid.ai
WATERMARK_POSITION=bottom-right
WATERMARK_OFFSET_X=20
WATERMARK_OFFSET_Y=20
WATERMARK_FONT_SIZE=36
WATERMARK_FONT_COLOR=white
WATERMARK_BG_COLOR=black
WATERMARK_BG_OPACITY=0.3

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT=300000

# Credits System
DEFAULT_SIGNUP_CREDITS=125
